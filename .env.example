# SmartPOS settings. Copy this file to ".env" (same folder) and fill in your values.
# Never share or upload .env: it holds your M-Pesa secrets.

# simulated = fake M-Pesa, no Daraja needed | sandbox = Safaricom test | live = real money
MPESA_MODE=simulated

# From your app on developer.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# Sandbox: the passkey and shortcode shown on the M-Pesa Express simulator
MPESA_PASSKEY=
MPESA_SHORTCODE=
# The till that receives the money (in sandbox, use the simulator's shortcode again)
MPESA_TILL=
# Sandbox only, if Daraja rejects Buy Goods, try: CustomerPayBillOnline
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline

# Public HTTPS address of this server from ngrok or Cloudflare Tunnel, no trailing slash
MPESA_CALLBACK_URL=
# A long random string. Generate one with: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
MPESA_CALLBACK_SECRET=

# ---- Receipt printer and cash drawer (see README) ----
# network:192.168.0.50 | cups:PrinterName | file:/dev/usb/lp0 | windows:Printer Name | none
SMARTPOS_PRINTER=none
# 48 for 80 mm paper, 32 for 58 mm paper
SMARTPOS_PRINTER_WIDTH=48
SMARTPOS_BUSINESS_NAME=My Shop
# Address, phone and tax PIN lines, separated by |
SMARTPOS_BUSINESS_LINES=Nairobi, Kenya|Tel 0700 000 000
SMARTPOS_RECEIPT_FOOTER=Thank you for shopping with us!
# 1 = open the cash drawer on cash sales (the drawer plugs into the printer). Try SMARTPOS_DRAWER_PIN=1 if it does not open.
SMARTPOS_DRAWER=1
SMARTPOS_DRAWER_PIN=0
# 1 = print the receipt automatically when a sale completes
SMARTPOS_AUTOPRINT=0

# ---- Internet outages ----
# How often (in minutes) the server finishes M-Pesa payments whose confirmation was lost. Default 2.
SMARTPOS_RECOVERY_MINUTES=2
# Optional: the host:port used to decide "are we online?". By default it is Safaricom's Daraja address, because that is what M-Pesa needs.
# SMARTPOS_ONLINE_CHECK=api.safaricom.co.ke:443

# ---- Accounts ----
# DEVELOPMENT ONLY: 1 = a brand-new database gets demo accounts (admin/admin123, cashier/cashier123) and sample products,
# and those demo passwords are accepted without forcing a change. Leave it OFF (or remove it) on a real shop.
SMARTPOS_DEMO=0
# A signed-in person is signed out after this many minutes without activity (default 480 = 8 hours).
SMARTPOS_SESSION_MINUTES=480

# ---- Manual M-Pesa checkout (when there is no internet) ----
# on = a cashier may confirm an M-Pesa payment by eye (code + amount from the customer's message) while offline. off = never.
SMARTPOS_MANUAL_MPESA=on
# The most one manually confirmed M-Pesa payment may be, in shillings.
SMARTPOS_MANUAL_MPESA_MAX=20000
